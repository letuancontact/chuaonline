# Copy to deploy/deploy.env (git-ignored) and fill in. Read by scripts/deploy-server.sh.

# SSH target of your server: a ~/.ssh/config alias or user@ip. The server needs Docker + the compose plugin.
DEPLOY_HOST=
# Folder on the server that holds docker-compose.yml and .env (created if missing).
REMOTE_DIR=~/santinh
# Browser origins allowed to open the WebSocket, comma-separated: where the client is hosted.
ALLOWED_ORIGINS=https://your-site.example,https://www.your-site.example
# Password for /admin (use letters and digits without accents). Empty = /admin is off.
ADMIN_PASSWORD=
# Docker network that the reverse proxy (Caddy, nginx...) shares with the container.
# Check with `docker network ls` on the server.
CADDY_NETWORK=
